{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "gitwall",
  "version": "0.1.0",
  "identifier": "dev.taubut.gitwall",
  "build": {
    "frontendDist": "../src"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "gitwall",
        "width": 1600,
        "height": 900,
        "fullscreen": true,
        "decorations": false,
        "resizable": true,
        "dragDropEnabled": false,
        "backgroundColor": "#0B0D12"
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: http://asset.localhost data: blob:; style-src 'self' 'unsafe-inline'; script-src 'self'; connect-src ipc: http://ipc.localhost",
      "assetProtocol": {
        "enable": true,
        "scope": {
          "requireLiteralLeadingDot": false,
          "allow": ["$CACHE/gitwall/**/*", "$DATA/gitwall/**/*"]
        }
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": ["deb", "appimage"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.png"],
    "category": "Utility",
    "shortDescription": "Wallpapers from any GitHub repo"
  }
}
